<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sunplus Multi-Loader Tool (OTG)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- اختيار منفذ COM / جهاز USB -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COM Port (USB Device):" android:textStyle="bold"/>
        <Spinner android:id="@+id/spinnerComPort" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="10dp"/>

        <!-- معدل السرعة BaudRate -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Baud Rate:" android:textStyle="bold"/>
        <Spinner android:id="@+id/spinnerBaudRate" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="10dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <!-- نوع الرام DDR Type -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DDR Type:" android:textStyle="bold"/>
                <Spinner android:id="@+id/spinnerDdrType" android:layout_width="match_parent" android:layout_height="48dp"/>
            </LinearLayout>

            <!-- نوع العملية Operate Type -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Operate Type:" android:textStyle="bold"/>
                <Spinner android:id="@+id/spinnerOperateType" android:layout_width="match_parent" android:layout_height="48dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <!-- خيار الـ Storage -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Storage:" android:textStyle="bold"/>
                <Spinner android:id="@+id/spinnerStorage" android:layout_width="match_parent" android:layout_height="48dp"/>
            </LinearLayout>

            <!-- خيار الـ Section -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Section:" android:textStyle="bold"/>
                <Spinner android:id="@+id/spinnerSection" android:layout_width="match_parent" android:layout_height="48dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- اختيار الملف -->
        <Button
            android:id="@+id/btnSelectFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختر ملف الفلاشة (.bin)"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvSelectedFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="لم يتم اختيار ملف"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginBottom="12dp"/>

        <!-- زر بدء الشحن -->
        <Button
            android:id="@+id/btnStartFlashing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="START FLASHING"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC" android:layout_marginBottom="10dp"/>

        <!-- سجل الأخطاء والعمليات (Log Area) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سجل العمليات والأخطاء (Log):"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#1E1E1E"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvStatusLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="في انتظار التوصيل والبدء..."
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:fontFamily="monospace"/>
        </ScrollView>

    </LinearLayout>
</ScrollView>
