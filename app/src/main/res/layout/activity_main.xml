<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="لودر صن بلس (Sunplus Loader)"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="منفذ USB / COM: USB Serial UART"
            android:textColor="#d0d0d0"
            android:textSize="13sp"
            android:gravity="right"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Parity) التكافؤ"
                    android:textColor="#d0d0d0"
                    android:textSize="12sp"
                    android:gravity="right" />

                <Spinner
                    android:id="@+id/spinnerParity"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#282828" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Baud Rate) معدل السرعة"
                    android:textColor="#d0d0d0"
                    android:textSize="12sp"
                    android:gravity="right" />

                <Spinner
                    android:id="@+id/spinnerBaudRate"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#282828" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(DDR Type) نوع الرام"
                    android:textColor="#d0d0d0"
                    android:textSize="12sp"
                    android:gravity="right" />

                <Spinner
                    android:id="@+id/spinnerDdrType"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#282828" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Chip Type) نوع المعالج"
                    android:textColor="#d0d0d0"
                    android:textSize="12sp"
                    android:gravity="right" />

                <Spinner
                    android:id="@+id/spinnerChipType"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#282828" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نوع العملية: كتابة (Write)"
            android:textColor="#d0d0d0"
            android:textSize="13sp"
            android:gravity="right"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Storage) نوع التخزين"
                    android:textColor="#d0d0d0"
                    android:textSize="12sp"
                    android:gravity="right" />

                <Spinner
                    android:id="@+id/spinnerStorage"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#282828" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Section) القسم"
                    android:textColor="#d0d0d0"
                    android:textSize="12sp"
                    android:gravity="right" />

                <Spinner
                    android:id="@+id/spinnerSection"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#282828" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Start) عنوان البداية"
                    android:textColor="#d0d0d0"
                    android:textSize="12sp"
                    android:gravity="right" />

                <EditText
                    android:id="@+id/editStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0x000000"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:backgroundTint="#666666" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Length) طول الملف"
                    android:textColor="#d0d0d0"
                    android:textSize="12sp"
                    android:gravity="right" />

                <EditText
                    android:id="@+id/editLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0x400000"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:backgroundTint="#666666" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnSelectFirmware"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختيار ملف السوفت وير"
            android:backgroundTint="#383838"
            android:textColor="#ffffff"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectDump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تحديد مسار الحفظ (DUMP PATH)"
            android:backgroundTint="#383838"
            android:textColor="#ffffff"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/txtFileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الملف المحدد: rom.bin\nحجم الملف: 4194304 بايت | CRC32: 0x61B4C8"
            android:textColor="#aaaaaa"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="إلغاء (STOP)"
                android:backgroundTint="#c62828"
                android:textColor="#ffffff"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="بدء العملية"
                android:backgroundTint="#2e7d32"
                android:textColor="#ffffff"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الحالة: بانتظار بدء العملية..."
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:gravity="right"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="سجل العمليات (Console Log):"
            android:textColor="#cccccc"
            android:textSize="12sp"
            android:gravity="right"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtConsoleLog"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#0d0d0d"
            android:padding="8dp"
            android:textColor="#4caf50"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="تم اختيار الملف: rom.bin | الحجم: 4194304\nتم اختيار مسار الحفظ لـ Dump بنجاح." />

    </LinearLayout>
</ScrollView>
